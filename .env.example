# Copy to .env for local development. NEVER commit a real .env.
#
# In production, secrets belong in a root-owned mode-600 file OUTSIDE the repository —
# somewhere like /etc/polaris/polaris.env — read by the service manager and never baked into
# an image. The reason is not tidiness: a secret in the tree is a secret in every clone, in
# every CI cache and in the history, and no later commit removes it from any of those.
#
# Every variable below that this build actually reads is declared in
# services/internal/platform/config.go. See docs/05-infrastructure/11-self-hosting.md.

# --- core ---------------------------------------------------------------
POLARIS_ENV=development
POLARIS_LOG_LEVEL=debug
POLARIS_PUBLIC_URL=http://localhost:5173

# --- datastores ---------------------------------------------------------
DATABASE_URL=postgres://polaris:polaris@localhost:55432/polaris?sslmode=disable

# --- auth ---------------------------------------------------------------
# 32+ random bytes, base64. Generate: openssl rand -base64 48
POLARIS_JWT_SECRET=dev-only-insecure-change-me-0000000000000000000
POLARIS_ACCESS_TOKEN_TTL=15m
POLARIS_REFRESH_TOKEN_TTL=720h

# Mint a session for the seed account (dev@polaris.local) when the browser is on
# localhost, so `make web` does not ask you to sign in after every reload.
#
# Default-on in development. The API still requires a loopback Host AND a
# loopback TCP peer, so a tunnel, a public hostname, or Docker self-host behind
# Caddy never gets a cookie. Production ignores this even when it is 1.
# Leave it off (or unset) on any install that is not your laptop.
POLARIS_DEV_AUTOLOGIN=1

# Who may create an account. "invite" (the default) or "open"; anything else and the
# process refuses to start rather than quietly falling back to the safe value.
#
#   invite  Two people, and nobody else. Somebody holding a valid, pending, unexpired
#           invitation — the token travels on the register call, so an invited person does
#           not need an account first — and the VERY FIRST account on an install that has
#           none, which is how you bootstrap yourself. That door closes the moment an
#           account exists and does not reopen if it is later deleted.
#
#   open    Anybody who can reach the endpoint, rate-limited and nothing more. The honest
#           escape hatch for a public or community instance. Read the registration section
#           of docs/05-infrastructure/11-self-hosting.md before setting it: it is the
#           configuration README says is not ready yet.
POLARIS_REGISTRATION_MODE=invite

# The plan a newly created workspace starts on: free | pro | enterprise | self_hosted.
#
# self_hosted is unlimited on seats, teams and history, and is the right answer for anybody
# running this themselves — it is what the README means by "self-host free and unlimited on
# seats". The other three exist for a hosted deployment, where the plan comes from billing.
#
# A value that is not one of the four stops the process at startup rather than at the first
# signup, which on a fresh install is the worst moment to find a typo.
POLARIS_DEFAULT_PLAN=self_hosted

# How many workspaces one account may belong to. 0 removes the limit.
#
# A resource bound, not a policy about who deserves a workspace: creating one seeds a team,
# its statuses and a change stream that the sync hub, the bootstrap endpoint and the fan-out
# job then carry forever. 20 is far above anything a person does by hand and far below
# anything that hurts.
POLARIS_MAX_WORKSPACES_PER_ACCOUNT=20

# --- listeners ----------------------------------------------------------
POLARIS_API_ADDR=:8088
POLARIS_SYNC_ADDR=:8089

# --- not implemented yet ------------------------------------------------
# Kept as a record of the intended shape, and commented out because nothing reads them.
#
# Setting them has no effect whatsoever: attachments, an external search engine and a
# metrics endpoint are all planned and none of them exist in this build. They were live
# here, which is worse than absent — somebody self-hosting generates S3 credentials, pastes
# them in, gets no error, and finds out attachments do not work by trying to attach a file.
#
# Search today is Postgres full-text and trigram, in the same database as everything else.
# Sync fan-out is Postgres LISTEN/NOTIFY, and rate-limit counters are in-process, so there
# is no Redis or Valkey either — see the comment at the top of internal/ratelimit.
#
# POLARIS_METRICS_ADDR=127.0.0.1:9090
#
# POLARIS_FILES_DRIVER=s3
# POLARIS_S3_ENDPOINT=http://localhost:59000
# POLARIS_S3_BUCKET=polaris
# POLARIS_S3_ACCESS_KEY=
# POLARIS_S3_SECRET_KEY=
# POLARIS_S3_REGION=eu-central-1
#
# POLARIS_SEARCH_DRIVER=meilisearch
# POLARIS_MEILI_URL=http://localhost:57700
# POLARIS_MEILI_KEY=

# --- mail ---------------------------------------------------------------
# Optional, and empty is the intended state for development and for most self-hosted
# installs. With no host set the product runs exactly as it does with one, except that the
# digest job says so once at startup and sends nothing.
#
# Username and password are optional too: a relay on 127.0.0.1 that accepts anything from
# the machine it runs on is the ordinary self-hosted setup. When they ARE set, the client
# refuses to send them to a relay that does not offer STARTTLS.
POLARIS_SMTP_HOST=
POLARIS_SMTP_PORT=587
POLARIS_SMTP_USERNAME=
POLARIS_SMTP_PASSWORD=
POLARIS_SMTP_TIMEOUT=30s
# The domain here is what SPF and DKIM are checked against. It has to be one this install is
# allowed to send as, or the digest lands in the spam folder.
POLARIS_MAIL_FROM=polaris@example.com
POLARIS_MAIL_FROM_NAME=Polaris

# GitHub App OAuth. Empty is supported: the product runs, the settings screen explains
# how to set these, and PR/commit linking still works from webhooks and GraphQL.
POLARIS_GITHUB_CLIENT_ID=
POLARIS_GITHUB_CLIENT_SECRET=
POLARIS_GITHUB_WEBHOOK_SECRET=
POLARIS_GITHUB_APP_ID=
POLARIS_GITHUB_APP_PRIVATE_KEY=

# Inbound email-to-issue webhook. Empty is the development stub: POST JSON to
# /webhooks/email with no secret. Set this in production.
POLARIS_EMAIL_WEBHOOK_SECRET=

# --- production compose only (docker-compose.yml) ------------------------
# The public hostname Caddy issues a certificate for. Leave as localhost for a laptop.
POLARIS_DOMAIN=localhost
# Required. Generate: openssl rand -base64 32
POSTGRES_PASSWORD=
# Required only with the "s3" profile.
S3_SECRET_KEY=
# Required only with the "search" profile.
MEILI_MASTER_KEY=
