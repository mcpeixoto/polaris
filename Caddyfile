# Caddy config for the default self-hosted deployment.
#
# One hostname for everything, so the browser sees one origin: no CORS for first-party
# clients, cookies work on every path, and the desktop app points at a single base URL.
#
# Set POLARIS_DOMAIN in .env. Leaving it as `localhost` makes Caddy issue a local
# certificate instead of asking Let's Encrypt for one, which is what you want on a laptop
# and what would fail on a public host.

{$POLARIS_DOMAIN:localhost} {
	encode zstd gzip

	# The sync socket. proxy_read_timeout has no Caddy equivalent because Caddy does not
	# impose one on a hijacked connection — an idle WebSocket stays open, which is the
	# behaviour this protocol needs and the one nginx has to be talked into.
	handle /sync* {
		reverse_proxy sync:8089
	}

	handle /graphql* {
		reverse_proxy api:8088
	}

	handle /auth/* {
		reverse_proxy api:8088
	}

	handle /webhooks/* {
		reverse_proxy api:8088
	}

	handle /files/* {
		reverse_proxy api:8088
	}

	# The SPA, and everything that is not one of the above.
	handle {
		reverse_proxy web:8080
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	log {
		output stdout
		format json
		# Health checks would otherwise be most of the log volume on an idle install.
		level INFO
	}
}
