          { "field": "assignee", "op": "isNull" }
        ]
      },
      "expect": ["e1", "e3"]
    },
    {
      "name": "four clauses, the shape the performance budget is written against",
      "filter": {
        "conj": "and",
        "nodes": [
          { "field": "team", "op": "eq", "values": ["b1"] },
          { "field": "stateCategory", "op": "in", "values": ["unstarted", "started"] },
