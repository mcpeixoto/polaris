          { "field": "stateCategory", "op": "in", "values": ["unstarted", "started"] },
          { "field": "priority", "op": "notIn", "values": ["0"] },
          { "field": "label", "op": "in", "values": ["d1", "d2", "d3"] }
        ]
      },
      "expect": ["e1", "e2"]
    },
    {
      "name": "a relative date resolves at evaluation time, not at save time",
      "filter": { "field": "createdAt", "op": "gte", "values": ["-10d"] },
      "expect": ["e2", "e3", "e4", "e5"]
    },
    {
      "name": "an absolute timestamp comparison",
      "filter": { "field": "createdAt", "op": "lt", "values": ["2026-08-06T00:00:00Z"] },
      "expect": ["e1", "e2"]
    },
    {
      "name": "completedAt is null for everything still open",
      "filter": { "field": "completedAt", "op": "isNotNull" },
      "expect": ["e4"]
    }
  ],

  "$errorsComment": [
    "These must be REJECTED, not silently ignored. An ignored clause widens the result set,",
    "and a filter that quietly matches more than it says is the exact bug that makes people",
    "stop trusting filters."
  ],
  "errors": [
    {
      "name": "an unknown field",
      "filter": { "field": "sprint", "op": "eq", "values": ["x"] },
      "message": "unknown field"
    },
    {
      "name": "an operator the field's type does not support",
      "filter": { "field": "priority", "op": "contains", "values": ["1"] },
      "message": "operator"
    },
    {
      "name": "isNull carrying values",
      "filter": { "field": "assignee", "op": "isNull", "values": ["a1"] },
      "message": "values"
    },
    {
      "name": "eq without values",
      "filter": { "field": "assignee", "op": "eq" },
      "message": "values"
    },
    {
      "name": "eq with more than one value",
      "filter": { "field": "assignee", "op": "eq", "values": ["a1", "a2"] },
      "message": "values"
    },
    {
      "name": "a conjunction that is neither and nor or",
      "filter": { "conj": "xor", "nodes": [] },
      "message": "conjunction"
    },
    {
      "name": "a node that is neither a clause nor a group",
      "filter": { "wat": true },
      "message": "clause"
    },
    {
      "name": "a value that is not a uuid where one is required",
      "filter": { "field": "assignee", "op": "eq", "values": ["not-a-uuid"] },
      "message": "uuid"
    },
    {
      "name": "a value that is not a number where one is required",
