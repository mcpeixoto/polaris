{
  "name": "@polaris/desktop",
  "productName": "Polaris",
  "description": "Polaris — the issue tracker for people who live in it.",
  "author": {
    "name": "Peixoto Labs",
    "email": "polaris@peixotolabs.com"
  },
  "homepage": "https://github.com/mcpeixoto/polaris",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "npm run build:electron && electron .",
    "build:electron": "tsc -p tsconfig.json && tsc -p tsconfig.preload.json",
    "build": "npm run build:electron && electron-builder --publish never",
    "release": "npm run build:electron && electron-builder --publish always",
    "smoke": "node scripts/smoke.mjs",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.preload.json --noEmit",
    "test": "npm run build:electron && node --test dist/main/googleOAuthCore.test.js"
  },
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.2",
    "@types/node": "^24.11.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
